"""
evals/datasets/golden_queries.jsonl
-------------------------------------
Golden evaluation dataset — 30 curated test cases.

Each line is a JSON object with:
  - query: the user message
  - expected_agents: agents the supervisor SHOULD select
  - expected_guardrail: "allow" or "block"
  - category: "valid_trip" | "ambiguous" | "adversarial" | "out_of_domain"
  - notes: explanation for evaluators

Usage:
  python evals/run_evals.py
"""
